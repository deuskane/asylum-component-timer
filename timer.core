CAPI=2:

#-----------------------------------------------------------------------------
# Title      : Timer Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : timer.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2021-10-26  1.0.0    mrosiere Created
# 2021-11-20  1.1.0    mrosiere Fix timer_event_r clear condition
# 2025-09-05  1.1.1    mrosiere Add Package
# 2025-11-01  2.0.0    mrosiere Add CSR, core rework
# 2025-11-22  2.0.1    mrosiere Use sbi instead pbi
# 2026-06-06  2.0.2    mrosiere Add Name
# 2026-10-05  2.0.3    mrosiere Self-checking UVVM bench of sbi_timer (sim_sbi_timer)
#                               replaces the legacy timer_v1 bench, remove unused
#                               parameters section
#-----------------------------------------------------------------------------

name        : asylum:component:timer:2.0.3
description : Timer

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/timer.hjson
      name         : timer
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  # Source Files
  #---------------------------------------
  files_hdl:
    files        :
      - hdl/timer_pkg.vhd
      - hdl/sbi_timer.vhd
      - hdl/timer_core.vhd
      - hdl/timer_v1.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - asylum:system:GIC
      - ">=asylum:utils:generators:2.8.0"
      - asylum:utils:pkg
      
  #---------------------------------------
  # Testbench Files
  #---------------------------------------
  files_sim:
    files:
      - sim/tb_sbi_timer.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_timer_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : timer
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_timer_wrapper)
    toplevel        : asylum.sbi_timer_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_timer_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:generators) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_timer_wrapper, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_v1_it :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_timer_wrapper, timer_v1 with interrupt, tick 10
    parameters      :
      - V1_IT_ENABLE=true
      - V1_TICK=10

  #---------------------------------------
  sim_sbi_timer:
  #---------------------------------------
    << : *default
    description     : Simulation of sbi_timer with SBI VIP
    filesets_append :
      - files_sim
    toplevel        : tb_sbi_timer
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

#=========================================
parameters :
#=========================================

  #---------------------------------------
  # Generics of sbi_timer_wrapper (lint_ghdl_synth_*)
  #---------------------------------------
  V1_TICK :
    description : timer_v1, tick period (clock cycles)
    datatype    : int
    default     : 1000
    paramtype   : generic

  V1_IT_ENABLE :
    description : timer_v1, interrupt enable
    datatype    : bool
    default     : false
    paramtype   : generic
